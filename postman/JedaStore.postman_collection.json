            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Produk Uji Postman\",\n  \"slug\": \"postman-{{product_suffix}}\",\n  \"price\": 25000,\n  \"category_id\": \"{{category_id}}\",\n  \"stock\": 5,\n  \"details\": [\n    \"Hanya produk pengujian\"\n  ],\n  \"rating\": 4.5,\n  \"sold\": 0\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"product_suffix\", pm.variables.replaceIn(\"{{$guid}}\"));"
            ]
